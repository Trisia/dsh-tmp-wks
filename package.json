{
  "name": "@cliven/dsh-tmp-wks",
  "version": "1.0.0",
  "type": "module",
  "description": "Sidebar \"New temp session\": create a throwaway workspace and start a session in it",
  "license": "MIT",
  "icon": "./dist/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trisia/dsh-tmp-wks.git"
  },
  "homepage": "https://github.com/Trisia/dsh-tmp-wks#readme",
  "bugs": {
    "url": "https://github.com/Trisia/dsh-tmp-wks/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "temp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./dist/locale/*.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}